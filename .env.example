# Port & Host
PORT=3000
NODE_ENV=development

# Database: MongoDB connection string (Atlas URI or local mongod)
MONGODB_URI="mongodb://localhost:27017/academic_portal"

# JWT Authentication
JWT_SECRET="academic_secret_jwt_key_2026_portal_production_grade"
